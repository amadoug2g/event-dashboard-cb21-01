# WeezEvent credentials — copie ce fichier en .env et remplis les valeurs
# (Back-office WeezEvent → Mon compte → Outils → Clé API)

WZ_API_KEY=VOTRE_API_KEY
WZ_TOKEN=VOTRE_ACCESS_TOKEN
WZ_EVENT_ID=VOTRE_ID_EVENEMENT

# Serveur
PORT=3000

# Intervalle de synchro en millisecondes (300000 = 5 min)
REFRESH_INTERVAL=300000
